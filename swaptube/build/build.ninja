  COMMAND = cd /workspace/swaptube/build && /usr/bin/cmake --regenerate-during-build -S/workspace/swaptube -B/workspace/swaptube/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

